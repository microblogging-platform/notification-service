# MongoDB
MONGO_INITDB_DATABASE=notification_db
MONGO_PORT=27017
# For Docker (with auth): mongodb://root:devpassword@mongodb:27017/?replicaSet=rs0&authSource=admin
# For Docker (no auth): mongodb://mongodb:27017/?replicaSet=rs0
# For local: mongodb://localhost:27017/
MONGO_URI=mongodb://root:devpassword@mongodb:27017/?replicaSet=rs0&authSource=admin

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
# Shared with user-management-service. Host = container name in microblogging-network
RABBITMQ_HOST=microblogging-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672
# Format: amqp://user:password@host:port/vhost
RABBITMQ_URI=amqp://admin:admin@microblogging-rabbitmq:5672/

# AWS SES (for email notifications)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_SENDER=noreply@example.com

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
NOTIFICATION_SERVICE_PORT=8001
